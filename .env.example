# Azure SQL deployment only
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=tcp:your-server.database.windows.net,1433;Initial Catalog=cloudtrack;User ID=replace-me;Password=replace-me;Encrypt=True;TrustServerCertificate=False
