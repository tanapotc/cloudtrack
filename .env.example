# Backend local development
JWT__SIGNINGKEY=replace-with-at-least-32-random-characters
ASPNETCORE_ENVIRONMENT=Development
SEED__ADMINEMAIL=admin@example.test
SEED__ADMINPASSWORD=replace-with-a-strong-local-only-password
POSTGRES_USER=cloudtrack
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
POSTGRES_DB=cloudtrack

# Azure PostgreSQL deployment only
DATABASE__PROVIDER=PostgreSql
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=...;Database=cloudtrack;Username=...;Password=...;SSL Mode=Require
